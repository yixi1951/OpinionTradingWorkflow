# Copy to /etc/openclaw-picks.env on ECS (chmod 600). Source from systemd units.
# Timezone for cron/timer
TZ=Asia/Shanghai

# Project root on server
OPENCLAW_PICKS_ROOT=/opt/openclaw-picks

# --- Sentiment REST endpoint (this repo's openclaw_ws_proxy) ---
OPENCLAW_URL=http://127.0.0.1:18790
OPENCLAW_TIMEOUT=180
OPENCLAW_PROBE_TIMEOUT=120
OPENCLAW_BATCH_SIZE=4

# Row-level LLM scoring in crawl (slow). Realtime uses aggregated + optional rescore.
OPENCLAW_SKIP_ROW_SCORE=1

# EOD batch rescore (openclaw-daily-eod.timer) — cap rows on 2G ECS
OPENCLAW_RESCORE_MAX_ROWS=120

# --- WebSocket gateway (OpenClaw CLI + DeepSeek) ---
OPENCLAW_GATEWAY_PORT=18789
WS_GATEWAY_URL=ws://127.0.0.1:18789
WS_GATEWAY_TOKEN=replace-with-openclaw-json-token
WS_GATEWAY_MODEL=deepseek/deepseek-v4-flash
WS_GATEWAY_AUTH_TIMEOUT=30
WS_GATEWAY_RESPONSE_TIMEOUT=180

# Optional Bearer for external callers of the proxy
# OPENCLAW_TOKEN=

# Python path
PYTHONPATH=/opt/openclaw-picks/src