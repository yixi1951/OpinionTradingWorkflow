# Demo-grade reverse proxy for Streamlit (not production OAuth).
# Replace YOUR_DOMAIN and paths; terminate TLS at Nginx or a cloud LB.

upstream streamlit_opinion_trading {
    server 127.0.0.1:8501;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name YOUR_DOMAIN;

    # ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;

    # Optional: basic auth in addition to STREAMLIT_DASHBOARD_PASSWORD
    # auth_basic "Restricted";
    # auth_basic_user_file /etc/nginx/.htpasswd_streamlit;

    location / {
        proxy_pass http://streamlit_opinion_trading;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }
}
