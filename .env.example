# =============================================================================
# Opinion Trading / OpenClaw — environment variables
# Copy to `.env` (or set in shell). Do NOT commit secrets.
# =============================================================================

# --- OpenClaw / LLM gateway (optional; keyword mode works offline) ---
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
# Optional WebSocket probe for --mode gateway-health
# OPENCLAW_WS_URL=ws://127.0.0.1:18789
# Force Stub pass (offline CI): GATEWAY_HEALTH_STUB=1
# Crawl proxies (comma-separated). Round-robin + failover in ProxyRotator.
# Not a captcha solver or login farm: PROXY_POOL=
# Optional short HTTP probe URL for --mode proxy-health (default http://example.com/)
# PROXY_HEALTH_URL=http://example.com/
OPENCLAW_MODEL=deepseek/deepseek-v4-flash
# 1 = skip per-row LLM during crawl (pipeline still batch-scores); 0 = score each post in crawl
OPENCLAW_SKIP_ROW_SCORE=1
OPENCLAW_MAX_POSTS=50
# Dashboard comment/舆情 evidence: merge raw CSVs within N days (see config collection.ui_raw_lookback_days)
# UI_RAW_LOOKBACK_DAYS=14

# --- Sentiment scoring ---
# ai = live cascade (recommended) | hybrid | keyword | jev
SCORING_MODE=ai
# Live cascade order (default from settings.yaml: jev,deepseek,keyword)
# SCORING_PROVIDER=jev,deepseek,keyword
# Attach JSONL historical recall into daily signal explanations (see docs/historical_memory.md)
# MEMORY_RECALL=1
AI_SCREEN_ENABLED=1
AI_PIPELINE_BATCH=12
# PARSE_MIN_CONTENT_CHARS=40

# --- Browser collect (Playwright) for xueqiu / weibo / douyin ---
BROWSER_COLLECT_ENABLED=1
# Paste cookie header strings (do NOT commit real values):
# XUEQIU_COOKIE=xq_a_token=...; u=...
# WEIBO_COOKIE=SUB=...; SUBP=...
# DOUYIN_COOKIE=...
# Or JSON map:
# PLATFORM_COOKIES_JSON={"xueqiu":"...","weibo":"...","douyin":"..."}

# --- HTTP crawl / anti-block ---
HTML_CACHE_DIR=data/html_cache
HTML_CACHE_TTL_SECONDS=3600
REQUEST_MIN_INTERVAL=1.5

# --- Parallel collection (daily workflow) ---
# COLLECT_PARALLEL=0 disables thread pool (serial crawl)
COLLECT_PARALLEL=1
COLLECT_MAX_WORKERS=6
# CLI tqdm bar when running main.py daily (requires tqdm)
COLLECT_SHOW_PROGRESS=0
# Progress JSONL written by workflow: data/reports/collect_progress_<date>.jsonl

# --- Streamlit dashboard ---
# If set, UI requires password before dashboard loads
STREAMLIT_DASHBOARD_PASSWORD=
# password | oauth | none  (oauth = stub + reverse-proxy SSO; see deploy/oauth.md)
# STREAMLIT_AUTH_BACKEND=password
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_DISCOVERY_URL=
# OAUTH_REDIRECT_URI=
# OAUTH_STUB_ALLOW=0

# --- Paper / backtest transaction cost calendar (research; off by default) ---
# TRANSACTION_COSTS=1

# --- Alerts (watchlist / realtime score deltas) ---
# ALERT_WEBHOOK_URL=
# DINGTALK_WEBHOOK=
# WECOM_WEBHOOK=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Development ---
PYTHONPATH=src

# --- TypeSafe Jev (primary live scorer; never commit a real key) ---
# TYPESAFE_API_KEY=
# JEV_API_KEY=          # alias for TYPESAFE_API_KEY
# JEV_MODEL=jev-latest  # or pin e.g. jev-1.13.0
# TYPESAFE_MODEL=       # alias for JEV_MODEL
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_TIMEOUT=30
# JEV_MIN_CONFIDENCE=0.40   # below this → failover to DeepSeek
# JEV_FALLBACK=1            # 0 = do not fall back when Jev HTTP/parse fails
# JEV_RETRIES=1
# JEV_RETRY_SLEEP=0.4

# --- DeepSeek live sentiment (failover after Jev; never commit a real key) ---
# Copy to `.env` or export in the shell. pytest does not need these.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT=30
# DEEPSEEK_REQUIRE=0
# 1 = error if scoring.mode=ai/hybrid (or HYBRID_USE_LLM=1) but key is missing
# DEEPSEEK_FALLBACK=1
# 0 = do not fall back to keyword when a live DeepSeek HTTP call fails
# Optional Qwen/DashScope hop after DeepSeek failure (OpenAI-compatible; CI has no keys):
# QWEN_API_KEY=
# DASHSCOPE_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-turbo
# LLM_QWEN_FALLBACK=1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=
# LLM_CACHE_TTL_SECONDS=86400
# LLM_CIRCUIT_THRESHOLD=3
# LLM_CIRCUIT_COOLDOWN_SEC=60
# USE_LLM_GATEWAY=1
# HYBRID_USE_LLM=0
# Live DeepSeek/hybrid stays off in CI (SCORING_MODE=keyword). Local live scoring:
#   export DEEPSEEK_API_KEY=sk-...
#   export SCORING_MODE=ai
#   python -m opinion_trading.main --mode deepseek-probe
#   python -m opinion_trading.main --mode score-sample
# INFERENCE_URL=http://127.0.0.1:8002
# COLLECTOR_URL=http://127.0.0.1:8001
# COMPUTE_URL=http://127.0.0.1:8003
# API_URL=http://127.0.0.1:8000

# --- Optional storage backends (file fallback if unset / driver missing) ---
# STORAGE_BACKEND=file|mysql|mongo|redis|multi
# MYSQL_URL=mysql+pymysql://user:pass@127.0.0.1:3306/opinion
# MONGO_URL=mongodb://127.0.0.1:27017
# MONGO_DB=opinion_trading
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Broker / execution (see docs/broker_integration.md) ---
# BROKER_MODE=paper
# paper | export | simulation | sandbox | http_sandbox
# ENABLE_HTTP_BROKER_SANDBOX=0
# BROKER_SANDBOX_URL=http://127.0.0.1:8765
# BROKER_SANDBOX_ALLOW_LIVE=0
# BROKER_SANDBOX_START_MOCK=0

# --- Next.js dashboard + API CORS ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# DASHBOARD_PASSWORD=          # optional Next.js gate (mirrors STREAMLIT_DASHBOARD_PASSWORD in compose)
# API_CORS_ENABLED=1
# API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000